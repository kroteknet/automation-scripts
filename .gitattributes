# Enforce LF line endings for shell scripts, Go sources, and manifests
*.sh text eol=lf
*.tpl text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sha256 text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Binary files - no line-ending conversion
*.tar.gz binary
binaries/*/krotek-*-linux-amd64 binary
binaries/*/krotek-*-linux-arm64 binary
